      lf='corm', hd='friend', lg='stack', lgm='trs', promo='Скидка на первый заказ −15%', sec=['grid'], vars={'--logo-size':'15px','--logo-size-m':'15px','--hd-h':'84px','--hd-hm':'76px','--ratio':'3/4'}, friend=True, pill=True, chipsoff=True),
