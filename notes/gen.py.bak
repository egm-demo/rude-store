 dict(t='Моно / техно', d='Моноширинный шрифт для цен и подписей, строгая сетка и тонкие линии. Как у технических брендов.',
      lf='archivo', hd='end', lg='trd', sec=['grid','launch'], vars={'--ui':"'IBM Plex Mono'",'--h-font':"'Archivo'",'--tile':'#f0f0f0'}, mono=True),

 # 25-30: витрины и мобильные решения
