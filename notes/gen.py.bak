 dict(t='Итог: END. × друг', d='Сборка лучшего: сетка и меню END., логотип друга в 3 строки (сворачивается в TRS), его плитки, лончи и скидки. Рекомендую как основу.',
      lf='corm', hd='end', lg='stack', lgm='trs', promo='Скидка на первый заказ −15%', sec=['hero_end','brands','grid','tiles','launch','sale','info'], vars={'--logo-size':'15px','--hd-h':'88px'}),
]
assert len(VARIANTS) == 30, len(VARIANTS)

def fix(h):
    return h.replace('src="img/','src="../img/').replace('src="img/${','src="../img/${')

def page(n, v):
    c = dict(v)
    card = {}
    if v.get('friend'): card.update(friend=True, brand=False)
    if v.get('stock'): card['stock'] = True
    card['like'] = True
    c['card'] = card
    secs = []
    for s in v['sec']:
        if s == 'grid':
            secs.append(S_grid(c, 'Новинки', 'all', 'g', v.get('cols', 4), not (v.get('chipsoff') or v.get('pill'))))
        else:
            secs.append(SEC[s](c))
    vars_ = ';'.join(f'{k}:{val}' for k, val in v['vars'].items())
    lgm = v.get('lgm')
    lgswap = f'<template id="lgm">{logo(lgm)}</template>' if lgm else ''
    pill = ''
    if v.get('pill'):
        pill = "T.pill('.grid[data-q=\"all\"]',{card:%s});" % json.dumps(card)
    cls = ' '.join(x for x in ['dark' if v.get('dark') else '', 'cs-friend' if v.get('friend') else '', 'mono' if v.get('mono') else '', 'ruled' if v.get('ruled') else '', 'stock' if v.get('stock') else ''] if x)
    js = JS.replace('%PILL%', pill).replace('%N%', str(n)).replace('%TITLE%', json.dumps(v['t'] + ' — ' + v['d'], ensure_ascii=False))
    swap = ''
    if lgm:
        swap = '''<script>(function(){const h=document.getElementById('hd'),w=h.querySelector('.lgw'),big=w.innerHTML,sm=document.getElementById('lgm').innerHTML;let s=0;addEventListener('scroll',()=>{const m=scrollY>120;if(m!==s){s=m;w.innerHTML=m?sm:big;}},{passive:true});})();</script>'''
    return fix(f'''<!doctype html><html lang="ru"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>№{n} {v['t']} — The Rude Store</title><link rel="icon" href="../favicon.svg">
<link rel="stylesheet" href="../fonts.css"><link rel="stylesheet" href="../base.css"><link rel="stylesheet" href="../extra.css">
<style>:root{{--logo-font:{LOGOF[v['lf']]};{vars_}}}</style></head>
<body class="{cls}">
{header(v['hd'], v['lg'], v.get('promo'))}{lgswap}
<main>{''.join(secs)}</main>
{FOOT('stack' if v['lg'] in ('stack','trs','badge') else v['lg'])}
<script>window.IMG='../img/';</script><script src="../products.js"></script><script src="../r.js"></script>{js}{swap}
</body></html>''')

os.makedirs(V, exist_ok=True)
for i, v in enumerate(VARIANTS, 1):
    open(f'{V}\\{i:02d}.html', 'w', encoding='utf-8').write(page(i, v))
json.dump([{'n': i, 't': v['t'], 'd': v['d']} for i, v in enumerate(VARIANTS, 1)], open(R + r'\variants.json', 'w', encoding='utf-8'), ensure_ascii=False)
print('ok', len(VARIANTS))
