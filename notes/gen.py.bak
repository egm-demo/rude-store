# Генератор 30 макетов THE RUDE STORE
import json, os
R = r'C:\Users\maya\TheRudeStore'
V = R + r'\v'

LOGOF = {
 'tenor': "'Tenor Sans'", 'corm': "'Cormorant Garamond'", 'bodoni': "'Bodoni Moda'",
 'cormsc': "'Cormorant SC'", 'belleza': "'Belleza'", 'jost': "'Jost'", 'anton': "'Anton'", 'archivo': "'Archivo'",
}

def logo(kind):
    return {
     'stack': '<span class="lg stack"><span>The</span><span>Rude</span><span>Store</span></span>',
     'one': '<span class="lg one">Rudestore</span>',
     'line': '<span class="lg">The Rude Store</span>',
     'trs': '<span class="lg mono">TRS</span>',
     'trd': '<span class="lg mono">T.R.D</span>',
     'badge': '<span class="lg badge">TRS</span>',
    }[kind]

def I(n): return f'<span class="ico" data-i="{n}"></span>'

NAV = ['Новинки','Обувь','Одежда','Куртки','Бренды','Sale']

def header(kind, lg, promo):
    pr = f'<div class="promo">{promo}</div>' if promo else ''
    if kind == 'end':   # END.: лого слева, меню по центру, иконки справа
        return pr + f'''<header class="hd end" id="hd"><div class="in">
<a href="#" class="lgw">{logo(lg)}</a>
<nav>{''.join(f'<a href="#g">{n}</a>' for n in NAV)}</nav>
<div class="r"><span class="search desk">{I('search')} Поиск по бренду или модели</span><span class="mob">{I('search')}</span>{I('user')}{I('heart')}{I('bag')}<span class="mob burger"></span></div></div></header>'''
    if kind == 'friend':  # макет друга: Меню / лого / Корзина
        return pr + f'''<header class="hd" id="hd"><div class="in">
<div class="l"><a class="txtlink" href="#">Меню</a></div>
<a href="#" class="lgw" style="justify-self:center">{logo(lg)}</a>
<div class="r"><a class="txtlink" href="#">Корзина</a></div></div></header>'''
    if kind == 'center':  # лого по центру, меню под ним
        return pr + f'''<header class="hd center" id="hd"><div class="in">
<div class="l">{I('search')}<span class="mob burger"></span></div>
<a href="#" class="lgw" style="justify-self:center">{logo(lg)}</a>
<div class="r">{I('user')}{I('heart')}{I('bag')}</div></div>
<nav class="subnav">{''.join(f'<a href="#g">{n}</a>' for n in NAV)}</nav></header>'''
    if kind == 'icons':  # бургер / лого / иконки
        return pr + f'''<header class="hd" id="hd"><div class="in">
<div class="l"><span class="burger"></span>{I('search')}</div>
<a href="#" class="lgw" style="justify-self:center">{logo(lg)}</a>
<div class="r">{I('heart')}{I('bag')}</div></div></header>'''
    if kind == 'side':  # лого слева крупно, меню текстом справа
        return pr + f'''<header class="hd end" id="hd"><div class="in">
<a href="#" class="lgw">{logo(lg)}</a><span></span>
<div class="r"><nav>{''.join(f'<a href="#g">{n}</a>' for n in NAV[:4])}</nav><a class="txtlink" href="#">Корзина (0)</a><span class="mob burger"></span></div></div></header>'''

# ---------- секции ----------
def S_hero_end(c):   # END.: большой баннер-лонч
    return f'''<section class="hero-full"><div class="art"><div><img src="img/p12.jpg" alt=""></div><div><img src="img/p04.jpg" alt=""></div><div><img src="img/p06.jpg" alt=""></div></div>
<div class="txt"><div class="eyebrow">Новое поступление</div><h1 class="hero-title">{c.get('ht','Оригиналы из-за рубежа. Без переплат.')}</h1><p>Кроссовки и одежда из США, Европы и Азии. В наличии и под заказ, доставка по России.</p><a class="btn" href="#g">Смотреть новинки</a></div></section>'''

def S_hero_logo(c):  # главная: огромный трёхстрочный логотип
    return f'''<section class="hero-logo"><div class="hl">{logo('stack')}</div>
<p class="hl-sub">{c.get('sub','Оригинальные кроссовки и одежда из США, Европы и Азии. Доставка по России.')}</p>
<div class="hl-cta"><a class="btn" href="#g">В каталог</a><a class="btn ghost" href="#info">Как заказать</a></div></section>'''

def S_hero_split(c):
    return f'''<section class="hero-split"><div class="hs-t"><div class="eyebrow">{c.get('eb','Сезон 25/26')}</div><h1 class="hero-title">{c.get('ht','Зима без компромиссов')}</h1><p>Пуховики The North Face, Puma и Jordan. Оригинал, под заказ от 10 дней.</p><a class="btn" href="#g">Выбрать куртку</a></div>
<div class="hs-i"><img src="img/p16.jpg" alt=""></div></section>'''

def S_hero_product(c):  # один товар героем, как лонч END.
    return f'''<section class="hero-prod"><div class="hp-i"><img src="img/p12.jpg" alt=""></div><div class="hp-t">
<div class="eyebrow">Launch · {c.get('date','22 ноября')}</div><h1 class="hero-title">Nike Air More<br>Uptempo</h1><p class="hp-p">Тот самый «AIR» на всю боковину. Чёрный, кожа, размеры 40–45.</p>
<div class="cp" style="font-size:18px"><span class="now">14 990 ₽</span><span class="old">19 990 ₽</span></div><div style="display:flex;gap:10px;margin-top:20px;flex-wrap:wrap"><a class="btn" href="#">Оставить заявку</a><a class="btn ghost" href="#g">Все лончи</a></div></div></section>'''

def S_carousel(c):  # макет друга: Мужское/Женское + карусель карточек с «Купить»
    return '''<div class="tabs"><button class="on">Мужское</button><button>Женское</button></div>
<section class="car"><div class="car-t" id="car"></div><div class="dots"><i class="on"></i><i></i><i></i><i></i><i></i></div></section>'''

def S_tiles(c):  # инста-плитки друга: сиреневые/зелёные
    a, b = c.get('t1', '#CBB1DC'), c.get('t2', '#B2DFC0')
    da = ' dk' if a in ('#111','#1c1c1c','#d6452b','#2f5d50') else ''
    db = ' dk' if b in ('#111','#1c1c1c','#d6452b','#2f5d50') else ''
    return f'''<section class="wrap sec"><div class="tiles">
<div class="tl" style="background:#fff;color:#111"><b>−15%</b><span>Доставка<br>по России</span></div>
<div class="tl tb{da}" style="background:{a}"><span>Доставка<br>по России</span></div>
<div class="tl tb{da}" style="background:{a}"><span>Под заказ</span></div>
<div class="tl tb{db}" style="background:{b}"><span>В наличии</span></div></div></section>'''

def S_brands(c):
    return '<div class="brands">' + ''.join(f'<a href="#g">{b}</a>' for b in ['Nike','Jordan','The North Face','Puma','VLONE','Old Order','Cav Empt']) + '</div>'

def S_cats(c):  # 3 большие категории
    return '''<section class="wrap sec"><div class="cats">
<a href="#g" class="cat"><div class="ci" style="--ratio:4/5"><img src="img/p18.jpg" alt=""></div><b>Обувь</b><span>16 моделей</span></a>
<a href="#g" class="cat"><div class="ci" style="--ratio:4/5"><img src="img/p22.jpg" alt=""></div><b>Куртки</b><span>4 модели</span></a>
<a href="#g" class="cat"><div class="ci" style="--ratio:4/5"><img src="img/p08.jpg" alt=""></div><b>Одежда</b><span>4 модели</span></a></div></section>'''

def S_grid(c, title='Новинки', q='all', key='g', cols=4, chips=True, opts=None, limit=None):
    o = json.dumps(opts or c.get('card', {}))
    ch = '<div class="chips" id="ch-'+key+'"></div>' if chips else ''
    return f'''<section class="wrap sec" id="{key}"><div class="sechead"><div><div class="eyebrow">{c.get('gEb','Каталог')}</div><h2 class="h2">{title}</h2></div><a href="#">Смотреть всё</a></div>
{ch}<div class="grid" style="--cd:{cols};margin-top:{'22px' if chips else '0'}" data-q="{q}" data-o='{o}' data-l="{limit or ''}" data-ch="{'ch-'+key if chips else ''}"></div></section>'''

def S_launch(c):  # календарь релизов, как END. Launches
    rows = [(3,'22 НОЯ','Nike Air More Uptempo','Заявки открыты'),(4,'25 НОЯ','Air Jordan 1 Mid SE','Скоро'),(6,'29 НОЯ','Nike Air Max 90','Скоро'),(16,'2 ДЕК','TNF Nuptse 1996','Предзаказ')]
    pid = {3:12,4:4,6:6,16:16}
    return '<section class="wrap sec"><div class="sechead"><div><div class="eyebrow">Launches</div><h2 class="h2">Ближайшие релизы</h2></div><a href="#">Календарь</a></div><div class="launch">' + ''.join(
      f'<a class="ln" href="#"><div class="ci" style="--ratio:1/1"><img src="img/p{pid[k]:02d}.jpg" alt=""></div><div class="lnd">{d}</div><div class="cn" style="min-height:0">{n}</div><div class="lns">{s}</div></a>' for k,d,n,s in rows) + '</div></section>'

def S_info(c):
    return '''<section class="wrap sec" id="info"><div class="info">
<div><b>01</b><h3>Оригинал</h3><p>Покупаем в официальных магазинах и у проверенных байеров. Чек и бирки сохраняем.</p></div>
<div><b>02</b><h3>Под заказ от 10 дней</h3><p>Нет в наличии? Привезём нужную модель и размер из США, Европы или Азии.</p></div>
<div><b>03</b><h3>Доставка по России</h3><p>СДЭК и Почта до двери. По Москве можно забрать лично.</p></div></div></section>'''

def S_editorial(c):  # RETROSUPERFUTURE: крупная типографика и цвет
    return f'''<section class="edit"><div class="ed-t">{c.get('et','Rude<br>by nature.')}</div><div class="ed-g"><img src="img/p04.jpg" alt=""><img src="img/p14.jpg" alt=""></div></section>'''

def S_logo3(c):  # три формы логотипа: 3 строки, 1 строка, знак
    return f'''<section class="wrap sec"><div class="sechead"><div><div class="eyebrow">Айдентика</div><h2 class="h2">В 3 строки, в одну и знак</h2></div></div>
<div class="l3"><div>{logo('stack')}<small>Главная</small></div><div>{logo('one')}<small>Шапка, чек, пакет</small></div><div>{logo('trs')}<small>Внутренние страницы</small></div><div>{logo('badge')}<small>Иконка, аватар</small></div></div></section>'''

def S_sale(c): return S_grid(c, 'Скидки до 50%', 'sale', 's', 4, False, limit=8)
def S_shoes(c): return S_grid(c, 'Кроссовки', 'shoes', 'sh', 4, False, limit=8)
def S_jackets(c): return S_grid(c, 'Куртки и худи', 'wear', 'w', 4, False)

SEC = dict(hero_end=S_hero_end, hero_logo=S_hero_logo, hero_split=S_hero_split, hero_product=S_hero_product,
  carousel=S_carousel, tiles=S_tiles, brands=S_brands, cats=S_cats, grid=S_grid, launch=S_launch, info=S_info,
  editorial=S_editorial, logo3=S_logo3, sale=S_sale, shoes=S_shoes, jackets=S_jackets)

FOOT = lambda lg: f'''<footer class="ft"><div>{logo(lg)}<p>Оригинальные кроссовки и одежда из-за рубежа. Доставка по России.</p></div>
<div><h4>Магазин</h4><a href="#g">Новинки</a><a href="#g">Обувь</a><a href="#g">Одежда</a><a href="#g">Sale</a></div>
<div><h4>Помощь</h4><a href="#info">Как заказать</a><a href="#info">Доставка</a><a href="#info">Оригинальность</a></div>
<div><h4>Связь</h4><a href="https://vk.com/choooice" target="_blank" rel="noopener">ВКонтакте</a></div></footer>'''

JS = r'''<script>
(function(){const T=TRS,P=T.P;
document.querySelectorAll('.ico[data-i]').forEach(e=>e.innerHTML=T.ICON[e.dataset.i]);
const Q={all:P,sale:P.filter(p=>p.old).sort((a,b)=>T.off(b)-T.off(a)),shoes:P.filter(p=>p.cat==='Обувь'),wear:P.filter(p=>p.cat!=='Обувь')};
document.querySelectorAll('.grid[data-q]').forEach(g=>{const o=JSON.parse(g.dataset.o||'{}');let l=Q[g.dataset.q]||P;if(g.dataset.l)l=l.slice(0,+g.dataset.l);T.grid(g,l,o);
 if(g.dataset.ch){T.chips('#'+g.dataset.ch,g,{card:o,cats:['Всё','Обувь','Одежда','Куртки','Nike','Jordan']});}});
const car=document.getElementById('car');
if(car){car.innerHTML=[16,22,5,21,8].map(id=>{const p=P.find(x=>x.id===id);return `<div class="cc"><img src="img/${p.img}" alt=""><div class="cct">${p.brand}<br>${p.name}</div><div class="ccb"><span>${T.rub(p.price)}</span><a href="#">Купить</a></div></div>`}).join('');
 const dots=[...document.querySelectorAll('.dots i')];car.addEventListener('scroll',()=>{const i=Math.round(car.scrollLeft/(car.firstElementChild.offsetWidth+12));dots.forEach((d,k)=>d.classList.toggle('on',k===i))},{passive:true});}
document.querySelectorAll('.tabs').forEach(t=>t.addEventListener('click',e=>{const b=e.target.closest('button');if(!b)return;t.querySelectorAll('button').forEach(x=>x.classList.toggle('on',x===b))}));
T.drawer();T.collapse('#hd',120);
%PILL%
T.mark(%N%,%TITLE%);})();
</script>'''

