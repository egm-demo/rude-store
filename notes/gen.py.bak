      lf='archivo', hd='side', lg='one', sec=['editorial','grid','tiles'], vars={'--h-font':"'Archivo'",'--logo-size':'22px','--ed-bg':'#e9e2d0'}, et='RUDE<br>STORE', t1='#d6452b', t2='#2f5d50'),
